{%- assign s = section.settings -%}
<section class="section section--flush-top">
  <div class="container contact-layout">
    <div class="contact-details" data-reveal>
      {%- if s.text != blank -%}<div class="rte muted">{{ s.text }}</div>{%- endif -%}
      <dl class="contact-details">
        {%- if settings.support_email != blank -%}<div><dt>{{ 'contact.email' | t }}</dt><dd><a href="mailto:{{ settings.support_email }}" class="link" style="text-transform: none; letter-spacing: .02em; font-size: var(--fs-md)">{{ settings.support_email }}</a></dd></div>{%- endif -%}
        {%- if settings.support_phone != blank -%}<div><dt>{{ 'contact.phone' | t }}</dt><dd><a href="tel:{{ settings.support_phone | remove: ' ' }}">{{ settings.support_phone }}</a></dd></div>{%- endif -%}
        {%- if settings.support_hours != blank -%}<div><dt>{{ 'contact.hours' | t }}</dt><dd>{{ settings.support_hours }}</dd></div>{%- endif -%}
        {%- if settings.store_address != blank -%}<div><dt>{{ 'contact.address' | t }}</dt><dd>{{ settings.store_address | newline_to_br }}</dd></div>{%- endif -%}
      </dl>
      {% render 'social-links' %}
    </div>
    <div data-reveal>
      {%- form 'contact', id: 'ContactForm', class: 'form-grid' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" data-autofocus>{{ 'contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="form-grid form-grid--2">
          <div class="field"><label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label><input class="field__input" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
          <div class="field"><label class="field__label" for="ContactEmail">{{ 'contact.email' | t }} *</label><input class="field__input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
        </div>
        <div class="form-grid form-grid--2">
          <div class="field"><label class="field__label" for="ContactPhone">{{ 'contact.phone' | t }}</label><input class="field__input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
          <div class="field"><label class="field__label" for="ContactOrder">{{ 'contact.order' | t }}</label><input class="field__input" id="ContactOrder" name="contact[order]" value="{{ form.order }}"></div>
        </div>
        <div class="field"><label class="field__label" for="ContactMessage">{{ 'contact.message' | t }} *</label><textarea class="field__input" id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
        <div><button type="submit" class="btn">{{ 'contact.send' | t }}</button></div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "class": "section-contact",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Intro text", "default": "<p>Questions about a piece, an order or sizing? Write to us and our team will reply by email.</p>" }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
