<section class="container not-found">
  <div class="page-hero__inner">
    <p class="not-found__num gold-text" aria-hidden="true">404</p>
    <h1 class="h2">{{ 'general.not_found' | t }}</h1>
    <p class="muted">{{ 'general.not_found_sub' | t }}</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center">
      <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      <button type="button" class="btn btn--outline" data-drawer-open="SearchOverlay">{{ 'header.search' | t }}</button>
    </div>
  </div>
</section>

{% schema %}
{ "name": "404" }
{% endschema %}
