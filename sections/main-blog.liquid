<div class="page-hero">
  <div class="container page-hero__inner">
    <span class="eyebrow">{{ 'blog.journal' | t }}</span>
    <h1 class="h1" data-split>{{ blog.title }}</h1>
    {%- if blog.all_tags.size > 0 -%}
      <div class="predictive__terms" style="justify-content: center; margin: 12px 0 0">
        <a class="chip{% unless current_tags %} chip--active{% endunless %}" href="{{ blog.url }}">{{ 'blog.all' | t }}</a>
        {%- for tag in blog.all_tags -%}<a class="chip{% if current_tags contains tag %} chip--active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
<div class="container" style="padding-bottom: var(--section-pad)">
  {%- paginate blog.articles by 9 -%}
    <div class="posts" data-stagger>
      {%- for article in blog.articles -%}{% render 'article-card', article: article %}{%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog" }
{% endschema %}
