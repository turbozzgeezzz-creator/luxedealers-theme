{%- assign s = section.settings -%}
<section class="page-hero{% if s.image != blank %} page-hero--image{% endif %}">
  {%- if s.image != blank -%}<div class="page-hero__media" data-parallax style="--parallax: 40px">{% render 'image', image: s.image, sizes: '100vw', loading: 'eager' %}</div>{%- endif -%}
  <div class="container page-hero__inner">
    {%- if s.eyebrow != blank -%}<span class="eyebrow" data-reveal>{{ s.eyebrow }}</span>{%- endif -%}
    <h1 class="h1" data-split>{{ s.heading | default: page.title | newline_to_br }}</h1>
    {%- if s.text != blank -%}<p data-reveal>{{ s.text }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page header",
  "class": "section-page-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "text", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
