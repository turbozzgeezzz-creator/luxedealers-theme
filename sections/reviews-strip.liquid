{%- comment -%}
  Store-wide rating and a row of real reviews, gathered from Judge.me data on
  the products in the chosen collection. Hidden when there are none.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign c = s.collection | default: collections.all
  assign avg = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
  assign total = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count
  assign shown = 0
-%}
{%- capture cards -%}
  {%- for p in c.products limit: 80 -%}
    {%- assign jd = p.metafields.judgeme.review_widget_data.value -%}
    {%- if jd.number_of_reviews > 0 -%}
      {%- for review in jd.reviews limit: 1 -%}
        {%- if review.body != blank and review.rating >= s.min_rating -%}
          {% render 'review-card', review: review, product_title: p.title, product_url: p.url %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
<section class="section reviews-strip">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="h2">{{ s.heading }}</h2>
        {%- if avg != blank and total != blank -%}
          <p class="reviews-strip__score"><span class="rating__stars rating__stars--gold" aria-hidden="true"><span style="--pct: {{ avg | times: 20 }}%"></span></span><strong>{{ avg | times: 1 | round: 2 }} / 5</strong> {{ 'reviews.from_count' | t: count: total }}</p>
        {%- endif -%}
      </div>
      <div style="display: flex; gap: 10px; align-items: center">
        {%- if s.link != blank -%}<a class="pill-link" href="{{ s.link }}">{{ s.link_label }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>{%- endif -%}
        <div class="rail__controls"><button type="button" class="rail__btn" data-rail-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', class: 'icon--sm' %}</button><button type="button" class="rail__btn" data-rail-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</button></div>
      </div>
    </div>
    <div class="rail" data-rail><div class="rail__track reviews-strip__track">{{ cards }}</div></div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews strip",
  "class": "section-reviews-strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "collection", "id": "collection", "label": "Take reviews from" },
    { "type": "range", "id": "limit", "label": "Reviews to show", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "min_rating", "label": "Lowest star rating to show", "min": 1, "max": 5, "step": 1, "default": 1, "info": "1 shows every review, good or bad." },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "All reviews" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Reviews strip" }]
}
{% endschema %}
