<div class="page-hero">
  <div class="container page-hero__inner">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="h1" data-split>{{ section.settings.heading }}</h1>
    <p>{{ 'wishlist.note' | t }}</p>
  </div>
</div>
<div class="container" style="padding-bottom: var(--section-pad)">
  <div class="product-grid product-grid--4" data-wishlist-grid></div>
  <div class="wishlist-empty" data-wishlist-empty hidden>
    <p class="h3">{{ 'wishlist.empty' | t }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Saved for later" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your wishlist" }
  ]
}
{% endschema %}
