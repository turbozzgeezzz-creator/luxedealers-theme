{%- comment -%} Free shipping bar, gift note, totals and checkout. Shared by drawer and cart page. {%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign show_bar = false
  if threshold > 0 and cart.currency.iso_code == shop.currency
    assign show_bar = true
  endif
  assign remaining = threshold | minus: cart.total_price
  assign pct = 0
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
{%- if show_bar -%}
  <div class="ship-bar">
    <span>
      {%- if remaining > 0 -%}{%- assign remaining_money = remaining | money -%}{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}{%- else -%}{{ 'cart.free_shipping_unlocked' | t }}{%- endif -%}
    </span>
    <div class="ship-bar__track" aria-hidden="true"><div class="ship-bar__fill" style="--pct: {{ pct }}%"></div></div>
  </div>
{%- endif -%}
{%- if settings.cart_gift_note -%}
  <details class="cart-gift"{% if cart.note != blank %} open{% endif %}>
    <summary>{{ 'cart.gift_message' | t }} {% render 'icon', name: 'gift', class: 'icon--sm' %}</summary>
    <label class="visually-hidden" for="CartNote-{{ context }}">{{ 'cart.gift_message' | t }}</label>
    <textarea class="field__input" id="CartNote-{{ context }}" name="note" data-cart-note placeholder="{{ 'cart.gift_placeholder' | t }}">{{ cart.note }}</textarea>
  </details>
{%- endif -%}
{%- for d in cart.cart_level_discount_applications -%}
  <div class="cart-totals" style="font-size: var(--fs-sm)"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
{%- endfor -%}
<div class="cart-totals"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
<button type="submit" name="checkout" form="CartForm-{{ context }}" class="btn btn--block">{% render 'icon', name: 'lock', class: 'icon--sm' %} {{ 'cart.checkout' | t }}</button>
{%- if settings.cart_note_text != blank -%}<div class="cart-note rte">{{ settings.cart_note_text }}</div>{%- endif -%}
