{%- comment -%}
  Header logo: the uploaded logo (Theme settings > Logo), or the LuxeDealers
  mark: a faceted gold diamond beside the LUXEDEALERS wordmark. Header only.
{%- endcomment -%}
{%- if settings.logo != blank -%}
  {%- assign h2x = settings.logo_height | times: 2 -%}
  {{ settings.logo | image_url: height: h2x | image_tag: height: settings.logo_height, alt: shop.name, loading: 'eager', fetchpriority: 'high' }}
{%- else -%}
  <span class="brandmark" aria-label="{{ shop.name | escape }}">
    <svg class="brandmark__gem" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="bmGold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7A5412"/><stop offset=".3" stop-color="#E2B957"/><stop offset=".5" stop-color="#FFF1C1"/><stop offset=".7" stop-color="#D4A73E"/><stop offset="1" stop-color="#8A6116"/></linearGradient>
      </defs>
      <circle cx="24" cy="24" r="22.5" fill="#0D0B07" stroke="url(#bmGold)" stroke-width="1.6"/>
      <g stroke="url(#bmGold)" stroke-width="1.5" stroke-linejoin="round" fill="none">
        <path d="M12 19.5 17.5 13h13l5.5 6.5L24 36z"/>
        <path d="M12 19.5h24M17.5 13l3.2 6.5L24 13l3.3 6.5L30.5 13M20.7 19.5 24 36l3.3-16.5"/>
      </g>
      <path d="M17.5 13h13l5.5 6.5H12z" fill="url(#bmGold)" opacity=".28"/>
    </svg>
    <span class="brandmark__word"><span class="brandmark__luxe">LUXE</span><span class="brandmark__dealers">DEALERS</span></span>
  </span>
{%- endif -%}
