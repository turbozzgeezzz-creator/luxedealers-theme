{%- comment -%}
  Header logo: the uploaded logo (Theme settings > Logo), or the LUXEDEALERS wordmark on its own
  (navy, with a yellow accent). Header only.
{%- endcomment -%}
{%- if settings.logo != blank -%}
  {%- assign h2x = settings.logo_height | times: 2 -%}
  {{ settings.logo | image_url: height: h2x | image_tag: height: settings.logo_height, alt: shop.name, loading: 'eager', fetchpriority: 'high' }}
{%- else -%}
  <span class="brandmark" aria-label="{{ shop.name | escape }}">
    <span class="brandmark__word"><span class="brandmark__luxe">LUXE</span><span class="brandmark__dealers">DEALERS</span></span>
  </span>
{%- endif -%}
