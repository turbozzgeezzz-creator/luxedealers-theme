{%- comment -%}
  Header logo: the uploaded logo (Theme settings > Logo), or the gold
  LUXEDEALERS wordmark set in Cinzel. Shown in the header only.
{%- endcomment -%}
{%- if settings.logo != blank -%}
  {%- assign h2x = settings.logo_height | times: 2 -%}
  {{ settings.logo | image_url: height: h2x | image_tag: height: settings.logo_height, alt: shop.name, loading: 'eager', fetchpriority: 'high' }}
{%- else -%}
  <span class="wordmark" aria-label="{{ shop.name | escape }}"><span class="wordmark__cap">L</span>UXE<span class="wordmark__cap">D</span>EALERS</span>
{%- endif -%}
