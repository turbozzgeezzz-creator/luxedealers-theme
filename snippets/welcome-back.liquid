{%- comment -%} Filled by theme.js from the visitor's own last viewed product (stored on their device). {%- endcomment -%}
{%- if settings.welcome_back and request.page_type != 'product' and request.page_type != 'cart' -%}
  <aside class="welcome-back" data-welcome-back aria-label="{{ 'welcome.back' | t }}" hidden>
    <a class="welcome-back__media" href="#" data-wb-link tabindex="-1" aria-hidden="true"><img src="" alt="" data-wb-img loading="lazy"></a>
    <div class="welcome-back__text">
      <span class="eyebrow eyebrow--plain">{{ 'welcome.back' | t }}</span>
      <a class="welcome-back__title" href="#" data-wb-link data-wb-title></a>
      <a class="link" href="#" data-wb-link style="align-self: flex-start; font-size: 12px">{{ 'welcome.continue' | t }}</a>
    </div>
    <button type="button" class="icon-btn" data-wb-close aria-label="{{ 'welcome.dismiss' | t }}">{% render 'icon', name: 'close', class: 'icon--sm' %}</button>
  </aside>
{%- endif -%}
