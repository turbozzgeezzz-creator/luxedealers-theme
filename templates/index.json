    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders are processed within 5 to 10 business days, then sent by tracked post. Delivery to most countries usually takes 2 to 4 weeks. <a href=\"/policies/shipping-policy\">Shipping policy</a></p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we ship to most countries. Choose your country at the top of the page to see prices in your currency. Any customs duties or taxes are paid by the customer.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "My tracking number shows as invalid. Why?",
            "answer": "<p>Tracking numbers can take up to 48 hours to become active after your shipping email. If it still doesn't work after that, email support@luxedealers.com.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Are your items true to size?",
            "answer": "<p>Check the size charts before ordering: each product page links to them. If you're between sizes, email us and we'll help.</p>"
          }
        }
      },
